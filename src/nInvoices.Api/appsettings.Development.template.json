{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Database": {
    "Type": "SQLite"
  },
  "Compliance": {
    "Spain": {
      "Verifactu": {
        "Environment": "Test",
        "ProducerName": "yourName",
        "ProducerTaxId": "yourTaxId" },
      "Face": {
        "Environment": "Test" } } },  
  "Authentication": {
    "UseDevAuth": true
  },
