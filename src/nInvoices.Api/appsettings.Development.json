{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Database": {
    "Type": "SQLite"
  },
  "Authentication": {
    "UseDevAuth": true
  },
  "MultiUser": {
    "LegacyOwnerId": "dev-user-001"
  },
  "Gmail": {
    "RedirectUri": "http://localhost:5297/api/gmail/oauth/callback",
    "PostConnectRedirect": "http://localhost:3000/settings"
  }
}
