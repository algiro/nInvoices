{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source of your Grafana Cloud stack (grafanacloud-<stack>-prom)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "nInvoices: application",
  "uid": "ninvoices-app",
  "tags": [
    "ninvoices"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "description": "Timings of the nInvoices API: opening an invoice, rendering PDFs, and every request by name. Metrics: ninvoices.request.duration and ninvoices.pdf.render.duration (Docs/OBSERVABILITY.md). With little traffic a line has gaps: widen the time range.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Opening an invoice (GetInvoiceByIdQuery)",
      "description": "How long the API takes to return one invoice: p50 and p95.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ninvoices_request_duration_seconds_bucket{request=\"GetInvoiceByIdQuery\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ninvoices_request_duration_seconds_bucket{request=\"GetInvoiceByIdQuery\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "PDF render time by engine",
      "description": "p95 of rendering a PDF. chrome = HTML templates (invoice, timesheet); questpdf = the built-in layouts. browser=cold is a render that had to start Chrome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, engine, browser) (rate(ninvoices_pdf_render_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{engine}} {{browser}} p95",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Creating an invoice (GenerateInvoiceCommand)",
      "description": "p50 and p95 of generating an invoice (monthly or one-time).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ninvoices_request_duration_seconds_bucket{request=\"GenerateInvoiceCommand\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ninvoices_request_duration_seconds_bucket{request=\"GenerateInvoiceCommand\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Downloading PDFs (use case, end to end)",
      "description": "p95 per PDF request: includes loading the invoice and the render.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, request) (rate(ninvoices_request_duration_seconds_bucket{request=~\"GetInvoicePdfQuery|GetMonthlyReportPdfQuery|GetWorkedDaysCalendarPdfQuery\"}[$__rate_interval])))",
          "legendFormat": "{{request}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Slowest requests (p95 by request)",
      "description": "Every Mediator request, by name.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, request) (rate(ninvoices_request_duration_seconds_bucket{}[$__rate_interval]))))",
          "legendFormat": "{{request}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by outcome",
      "description": "Count over the selected range, by how the request ended (success, invalid, not_found, rejected, canceled, error).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (increase(ninvoices_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed requests (error)",
      "description": "Requests that ended with an unexpected error, by request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (request) (increase(ninvoices_request_duration_seconds_count{outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{request}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Invoices finalized",
      "description": "Invoices issued, by type, per hour of the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": true,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (type) (increase(ninvoices_invoices_finalized_total[$__interval]))",
          "legendFormat": "{{type}}",
          "range": true,
          "interval": "1h"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "E-invoice submissions by result",
      "description": "What the Tax Agency (verifactu) and FACe (face) answered. failed = not registered, tried again; rejected needs your attention.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": true,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (system, result) (increase(ninvoices_einvoice_submissions_total[$__interval]))",
          "legendFormat": "{{system}} {{result}}",
          "range": true,
          "interval": "1h"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Time the authority takes to answer (p95)",
      "description": "The call to the Tax Agency or FACe only. A rising line is their side.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, system) (rate(ninvoices_einvoice_submit_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{system}} p95",
          "range": true,
          "interval": "1h"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gmail drafts by outcome",
      "description": "created, or reconnect_required when a user's Gmail link broke and they must connect it again.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": true,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (increase(ninvoices_email_drafts_total[$__interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "interval": "1h"
        }
      ]
    }
  ]
}