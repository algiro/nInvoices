<Project>
  <!-- Settings every project shares; a .csproj only says what is particular to it -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- The .NET analyzers at the recommended level, and the .editorconfig style rules, in every build -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- A warning is a defect: the build fails on it (suppress with a reason in .editorconfig or at the site) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reproducible paths in CI builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
