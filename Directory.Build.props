<Project>
  <!-- Settings every project shares; a .csproj only says what is particular to it -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- The .NET analyzers at the recommended level, and the .editorconfig style rules, in every build -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- A warning is a defect: the build fails on it (suppress with a reason in .editorconfig or at the site) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reproducible paths in CI builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Application code reads the time only from the injected TimeProvider: the clock calls in
       BannedSymbols.txt are build errors (RS0030). Tests may use them, to build fixed times. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
