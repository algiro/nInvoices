# Settings for deploy.sh and deploy.ps1.
# Copy to deploy.local.env (git-ignored) and fill in your own server and domain.
# KEY=VALUE per line; environment variables of the same name take precedence (deploy.sh).

# SSH alias from your ~/.ssh/config (for deploy.ps1: WSL's), or user@host
SSH_HOST=your-server

# The server's directory holding its docker-compose.yml with services "api" and "web"
REMOTE_DIR=~/docker

# Where users reach Keycloak and the app
KEYCLOAK_URL=https://your-domain.com
API_URL=/nInvoices
BASE=/nInvoices
APP_URL=https://your-domain.com/nInvoices

# Docker Hub account the images are pushed to and pulled from
DOCKER_USERNAME=algiro
